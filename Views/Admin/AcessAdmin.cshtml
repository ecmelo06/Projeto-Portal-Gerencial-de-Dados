@model List<Project.Models.CadastroModel>

<div class="container mt-5">
    <h2>Lista de Usuários Cadastrados</h2>

    <!-- Alertas de Erro ou Sucesso das validações do Controller -->
    @if (TempData["Sucesso"] != null)
    {
        <div class="alert alert-success">@TempData["Sucesso"]</div>
    }
    @if (TempData["Erro"] != null)
    {
        <div class="alert alert-danger">@TempData["Erro"]</div>
    }

    <div class="table-responsive">
        <table class="table table-striped table-hover table-bordered align-middle">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Nome</th>
                    <th>E-mail</th>
                    <th>CPF</th>
                    <th>Órgão</th>
                    <th>Perfis</th>
                    <th class="text-center">Ações</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var usuario in Model)
                    {
                        bool ehAdmin = usuario.Perfils != null && usuario.Perfils.Any(p => p.Nome == "Admin" || p.Nome == "SuperAdmin");
                        
                        <tr>
                            <td>@usuario.Id</td>
                            <td>@usuario.Nome</td>
                            <td>@usuario.Email</td>
                            <td>@usuario.CPF</td>
                            <td>@usuario.Orgao</td>
                            <td>
                                @if (usuario.Perfils != null && usuario.Perfils.Any())
                                {
                                    foreach (var perfil in usuario.Perfils)
                                    {
                                        <span class="badge bg-primary me-1">@perfil.Nome</span>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted">Nenhum</span>
                                }
                            </td>
                            <td class="text-center">
                                <div class="btn-group" role="group">
                                    <a asp-action="Editar" asp-route-id="@usuario.Id" class="btn btn-sm btn-warning">Editar</a>

                                    @if (!ehAdmin)
                                    {
                                        <a asp-action="TornarAdmin" asp-route-id="@usuario.Id" class="btn btn-sm btn-info text-white">Tornar Admin</a>
                                        <a asp-action="ExcluirUsuario" asp-route-id="@usuario.Id" 
                                           onclick="return confirm('Tem certeza que deseja excluir este usuário?')" 
                                           class="btn btn-sm btn-danger">Excluir</a>
                                    }
                                    else{
                                        <button class="btn btn-sm btn-secondary" disabled title="Não é possível alterar outro Admin">Protegido</button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">Nenhum registro encontrado.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

    
    <div class="mt-3">
        <a asp-action="Logout" class="btn btn-danger">Sair</a>
    </div>
</div>
