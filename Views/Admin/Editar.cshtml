@model Project.Models.CadastroModel

    @if (TempData["Erro"] != null)
    {
        <div class="alert alert-danger">@TempData["Erro"]</div>
    }

<div class="container mt-5" style="max-width: 600px;">
    <h2>Editar Usuário</h2>
    <p class="text-muted">Altere as informações cadastrais abaixo:</p>

    <form asp-controller="ControllerLogin" asp-action="Editar" method="post">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="Senha" />
        <div class="mb-3">
            <label asp-for="Nome" class="form-label">Nome Completo</label>
            <input asp-for="Nome" class="form-for control form-control" required />
        </div>

        <div class="mb-3">
            <label asp-for="Email" class="form-label">E-mail</label>
            <input asp-for="Email" type="email" class="form-control" required />
        </div>

        <div class="mb-3">
            <label asp-for="CPF" class="form-label">CPF</label>
            <input asp-for="CPF" class="form-control" required />
        </div>

        <div class="mb-3">
            <label asp-for="Orgao" class="form-label">Órgão Vinculado</label>
            <input asp-for="Orgao" class="form-control" required />
        </div>

        <div class="mt-4">
            <button type="submit" class="btn btn-primary">Salvar Alterações</button>
            <a asp-action="AcessAdmin" class="btn btn-secondary">Cancelar</a>
        </div>
    </form>
</div>
