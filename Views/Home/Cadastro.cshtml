@model CadastroModel
@{
    ViewData["Title"] = "Cadastro";
}
<h1>@ViewData["Title"]</h1>

<form asp-controller="ControllerCadastro" asp-action="Criar" method="post">
  <div class="form-row">
    <div class="form-group col-md-4">
      <label for="Nome">Usuário</label>
      <input type="text" asp-for="Nome" class="form-control" id="user"">
    </div>
    <div class="form-group col-md-4">
      <label for="Senha">Senha</label>
      <input type="password" asp-for="Senha" class="form-control" id="password">
    </div>
  </div>
  <div class="form-group col-md-4">
    <label for="Email">E-mail</label>
    <input type="email" asp-for="Email" class="form-control" id="email">
  </div>
  <div class="form-group col-md-4">
    <label for="CPF">CPF</label>
    <input type="text" asp-for="CPF" class="form-control" id="cpf">
    <div class="form-group col-md-4">
      <label for="Orgao">Orgão</label>
      <input type="text" asp-for="Orgao" class="form-control" id="orgao" />
    </div>
  

    <br />
  <button type="submit" class="btn btn-primary">Cadastrar</button>
</form>