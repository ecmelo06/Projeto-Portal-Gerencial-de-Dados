@{
        ViewData["Title"] = "Recuperar Senha";
}

<div class="container mt-5" style="max-width: 450px;">
    <h3>Recuperar Senha</h3>
    <p class="text-muted">Insira seu e-mail para receber o código de acesso.</p>
    @if (TempData["Erro"] != null) { <div class="alert alert-danger">@TempData["Erro"]</div> }
    
        <form asp-action="EnviarEmailRecuperacao" method="post">
            <div class="mb-3">
                <label class="form-label">E-mail Cadastrado</label>
                <input type="email" name="email" class="form-control" required />
            </div>
            <button type="submit" class="btn btn-primary w-100">Enviar Código</button>
        </form>
    </div>
