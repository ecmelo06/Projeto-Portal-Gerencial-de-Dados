<div class="container mt-5" style="max-width: 450px;">
    <h3>Nova Senha</h3>
    <p class="text-muted">Crie uma nova senha forte para acessar sua conta.</p>
    @if (TempData["Erro"] != null) { <div class="alert alert-danger">@TempData["Erro"]</div> }

    <form asp-action="SalvarNovaSenha" method="post">
        <div class="mb-3">
            <label class="form-label">Nova Senha</label>
            <input type="password" name="novaSenha" class="form-control" required />
        </div>
        <div class="mb-3">
            <label class="form-label">Confirmar Nova Senha</label>
            <input type="password" name="confirmarSenha" class="form-control" required />
        </div>
        <button type="submit" class="btn btn-primary w-100">Alterar Senha</button>
    </form>
</div>
